{
  "app-id": "com.edde746.tortuga",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "tortuga",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=xdg-videos/Tortuga:create",
    "--filesystem=xdg-run/discord-ipc-0",
    "--filesystem=xdg-run/app/com.discordapp.Discord:create",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.freedesktop.ScreenSaver"
  ],
  "build-options": {
    "strip": false,
    "no-debuginfo": true
  },
  "modules": [
    {
      "name": "noto-sans",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm644 -t /app/share/fonts/noto-sans NotoSans/hinted/ttf/NotoSans-Regular.ttf NotoSans/hinted/ttf/NotoSans-Medium.ttf NotoSans/hinted/ttf/NotoSans-SemiBold.ttf NotoSans/hinted/ttf/NotoSans-Bold.ttf"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/notofonts/latin-greek-cyrillic/releases/download/NotoSans-v2.015/NotoSans-v2.015.zip",
          "sha256": "0c34df072a3fa7efbb7cbf34950e1f971a4447cffe365d3a359e2d4089b958f5",
          "strip-components": 0
        }
      ]
    },
    {
      "name": "tortuga",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a Tortuga /app/tortuga",
        "install -Dm644 -t /app/lib ubuntu-libs/*",
        "mkdir -p /app/share/licenses/com.edde746.tortuga && cp -a Tortuga/lib/app/resources/licenses/. /app/share/licenses/com.edde746.tortuga/",
        "mkdir -p /app/share/licenses/com.edde746.tortuga/mpv-build && cp -a Tortuga/lib/app/resources/mpv/licenses/. /app/share/licenses/com.edde746.tortuga/mpv-build/",
        "mkdir -p /app/bin && ln -s ../tortuga/bin/Tortuga /app/bin/tortuga",
        "install -Dm644 com.edde746.tortuga.desktop /app/share/applications/com.edde746.tortuga.desktop",
        "install -Dm644 com.edde746.tortuga.metainfo.xml /app/share/metainfo/com.edde746.tortuga.metainfo.xml",
        "mkdir -p /app/share/icons && cp -a hicolor /app/share/icons/"
      ],
      "sources": [
        { "type": "dir", "path": "Tortuga", "dest": "Tortuga" },
        { "type": "dir", "path": "ubuntu-libs", "dest": "ubuntu-libs" },
        { "type": "dir", "path": "hicolor", "dest": "hicolor" },
        { "type": "file", "path": "com.edde746.tortuga.desktop" },
        { "type": "file", "path": "com.edde746.tortuga.metainfo.xml" }
      ]
    }
  ]
}
