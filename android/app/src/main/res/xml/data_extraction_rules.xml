<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same rule as backup_rules.xml, for cloud backups and device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.edde746.tortuga.secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.edde746.tortuga.secrets.xml" />
    </device-transfer>
</data-extraction-rules>
