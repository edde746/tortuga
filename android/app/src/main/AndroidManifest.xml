<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The process follows the default network (ProcessNetwork): offline states, Wi-Fi only downloads, the trackers'
         replay when it comes back. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The media session's service runs in the foreground while a playback plays (PlaybackService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Downloads run in a foreground dataSync worker (DownloadWorker) with a progress notification, asked for at the
         first download (Android 13+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android TV's Watch Next row (WatchNext): the TV provider takes this app's rows only with it on some boxes. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- One APK for phones, tablets and Android TV. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Package visibility (API 30+): whether a browser can open a sign-in page or a link, and which player apps play
         video (AndroidPlayerApps: a stream at an http(s) URL, a download's content:// URI). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:mimeType="video/*" />
        </intent>
    </queries>

    <!-- Icons and the TV banner are generated by tools/brand/generate.sh. -->
    <application
        android:name=".TortugaApplication"
        android:banner="@drawable/banner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tortuga">
        <!-- One activity holds the whole app: configuration changes (rotation, folding, resizing, dark mode, entering and
             leaving picture-in-picture) don't recreate it, and a launch while it runs brings it back as it was.
             turnScreenOn lets a link that arrives during the screensaver wake the device and play; set at runtime it
             comes too late, as the activity is already launched behind the screensaver. -->
        <activity
            android:name=".MainActivity"
            android:turnScreenOn="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Watch-together invites (tortuga://watch?code=…&relay=…) join their room, a device link's QR code
                 (tortuga://link?server=…&code=…, scanned with a phone's camera) opens Settings → Account to approve the
                 new device, and a title link's page on usetortuga.app opens the title's Detail
                 (tortuga://detail?type=…&id=…): MainActivity.openLink. The test builds drop this filter and the Stremio
                 one (src/debug/AndroidManifest.xml). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tortuga" />
                <data android:host="watch" />
                <data android:host="link" />
                <data android:host="detail" />
            </intent-filter>
            <!-- A title's link, which Detail's Share sends (https://usetortuga.app/t/<type>/<id>), opens its Detail
                 (MainActivity.openLink) as an App Link: the system checks the site's /.well-known/assetlinks.json
                 for this package and its signing certificate, and opens such links in Tortuga without asking.
                 Unverified (a certificate the file doesn't list), they open in the browser, on the site's page. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="usetortuga.app" />
                <data android:pathPrefix="/t/" />
            </intent-filter>
            <!-- Stremio links (stremio://<host>/…/manifest.json installs an addon, stremio:///detail/… and the other
                 stremio:/// pages open their screen): MainActivity.openLink follows them. With the official Stremio
                 app installed too, Android asks which app opens them, or uses the one the user made the default. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stremio" />
            </intent-filter>
        </activity>
        <!-- Shows the playback's media notification, in the foreground while it plays. Media
             controllers reach the session through the system, not this service. -->
        <service
            android:name=".media.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- The media notification's actions and its dismissal (PlaybackNotification). -->
        <receiver
            android:name=".media.MediaActionReceiver"
            android:exported="false" />
        <!-- WorkManager's foreground service, which the download worker runs in: a data transfer (DownloadWorker). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <!-- The download notification's Pause and Cancel actions (DownloadNotifications). -->
        <receiver
            android:name=".downloads.android.DownloadActionReceiver"
            android:exported="false" />
        <!-- A download's file and its saved subtitles, read-only for the player app they are handed to
             (AndroidPlayerApps). -->
        <provider
            android:name=".players.PlayerFiles"
            android:authorities="${applicationId}.playerfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/player_files" />
        </provider>
        <!-- The home screen's word that the user removed one of this app's Watch Next rows (WatchNext). Sent by the
             system, so exported. -->
        <receiver
            android:name=".watchnext.WatchNextRemovedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.action.WATCH_NEXT_PROGRAM_BROWSABLE_DISABLED" />
            </intent-filter>
        </receiver>
        <!-- Sentry starts only while crash reports are on (AndroidCrashReports), never by itself at launch: its two
             start-up providers go. -->
        <provider
            android:name="io.sentry.android.core.SentryInitProvider"
            android:authorities="${applicationId}.SentryInitProvider"
            tools:node="remove" />
        <provider
            android:name="io.sentry.android.core.SentryPerformanceProvider"
            android:authorities="${applicationId}.SentryPerformanceProvider"
            tools:node="remove" />
    </application>
</manifest>
