# Copy to server/.env (git-ignored) and fill in. server/README.md explains every setting.
# The database password: here, or in a file POSTGRES_PASSWORD_FILE names inside the containers (mounted by an
# override file, as compose.hosted.yaml does); one or the other.
POSTGRES_PASSWORD=

# The data key file on the host (32 random bytes, readable by uid 10001), mounted into the server as a compose
# secret. It seals synced records at rest and is not part of the database backups: back it up separately; a restore
# needs the same key. Create it once, never overwrite it:
#   (umask 077; set -C; openssl rand 32 > server/tortuga-data.key) && sudo chown 10001 server/tortuga-data.key
# Relative paths are relative to server/. Default:
TORTUGA_DATA_KEY_PATH=./tortuga-data.key

# Where the server listens on the host (put a TLS reverse proxy in front).
TORTUGA_BIND=127.0.0.1
TORTUGA_HTTP_PORT=8080
TORTUGA_TRUST_FORWARDED_HEADERS=false

# Optional: your own OpenID Connect provider (Authentik, Keycloak, …) with a public client for the apps.
TORTUGA_OIDC_ISSUER=
TORTUGA_OIDC_CLIENT_IDS=
TORTUGA_OIDC_NAME=

# Optional: Sign in with GitHub through your own GitHub OAuth App (callback <your server's URL>/v2/auth/github/return,
# Device Flow on; server/README.md, Sign-in). Both or neither.
TORTUGA_GITHUB_CLIENT_ID=
TORTUGA_GITHUB_CLIENT_SECRET=

# Optional backups (docker compose --profile backup up -d).
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_SCHEDULE=17 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_AGE_RECIPIENTS=
